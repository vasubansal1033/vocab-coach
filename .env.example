APP_ENV=dev
DATABASE_URL=sqlite:///./data/app.db
# 64 random hex characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=replace-me

OIDC_ISSUER=http://localhost:9000/application/o/vocab-coach/
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me

# LiteLLM model strings, one per role. Pick them with the editor eval.
LLM_PARTNER_MODEL=ollama_chat/<local-model-tag>
LLM_EDITOR_MODEL=<provider>/<model-name>
LLM_USAGE_JUDGE_MODEL=<provider>/<model-name>
LLM_DRILL_GEN_MODEL=ollama_chat/<local-model-tag>
LLM_DRILL_GRADE_MODEL=<provider>/<model-name>
LLM_GROUP_GEN_MODEL=<provider>/<model-name>
OLLAMA_API_BASE=http://localhost:11434

# Active prompt file version per role (prompts/<role>.v<N>.md).
LLM_PARTNER_PROMPT_VERSION=1
LLM_EDITOR_PROMPT_VERSION=1
LLM_USAGE_JUDGE_PROMPT_VERSION=1
LLM_DRILL_GEN_PROMPT_VERSION=1
LLM_DRILL_GRADE_PROMPT_VERSION=1
LLM_GROUP_GEN_PROMPT_VERSION=1

# Hosted provider keys are read by LiteLLM from the environment, e.g.:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

EDITOR_MAX_SUGGESTIONS=2
# Internal users.id allowed to open /admin/lexicon
ADMIN_USER_ID=

# Rolling 24h LLM ceilings (0 disables). Checked against llm_calls.
LLM_RATE_LIMIT_PER_DAY=200
LLM_COST_LIMIT_USD_PER_DAY=5.0

# Shown on /about/privacy. Override if your providers differ.
# LLM_PRIVACY_NOTE=

# Postgres example (after infra/postgres is up):
# DATABASE_URL=postgresql+psycopg://vocab:replace-me@localhost:5432/vocab

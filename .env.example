APP_ENV=dev
DATABASE_URL=sqlite:///./data/app.db
# 64 random hex characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=replace-me

OIDC_ISSUER=http://localhost:9000/application/o/vocab-coach/
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me

# ---------------------------------------------------------------------------
# LLM providers (LiteLLM). Put API keys here; model strings use provider/model.
# Only vocab.llm talks to providers. Unit tests use FakeLLM and never need keys.
# ---------------------------------------------------------------------------

# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic (Claude): https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini: https://aistudio.google.com/apikey
# GEMINI_API_KEY=...

# Local Ollama (no cloud key): https://ollama.com
OLLAMA_API_BASE=http://localhost:11434

# One LiteLLM model string per role. Examples (uncomment one block):

# --- OpenAI ---
# LLM_PARTNER_MODEL=openai/gpt-4o-mini
# LLM_EDITOR_MODEL=openai/gpt-4o
# LLM_USAGE_JUDGE_MODEL=openai/gpt-4o-mini
# LLM_DRILL_GEN_MODEL=openai/gpt-4o-mini
# LLM_DRILL_GRADE_MODEL=openai/gpt-4o-mini
# LLM_GROUP_GEN_MODEL=openai/gpt-4o-mini
# LLM_CHOICE_GEN_MODEL=openai/gpt-4o-mini
# LLM_CONFUSABLE_GEN_MODEL=openai/gpt-4o-mini
# LLM_IDIOM_GEN_MODEL=openai/gpt-4o-mini

# --- Anthropic Claude ---
# LLM_PARTNER_MODEL=anthropic/claude-sonnet-4-5-20250929
# LLM_EDITOR_MODEL=anthropic/claude-sonnet-4-5-20250929
# LLM_USAGE_JUDGE_MODEL=anthropic/claude-haiku-4-5-20251001
# LLM_DRILL_GEN_MODEL=anthropic/claude-haiku-4-5-20251001
# LLM_DRILL_GRADE_MODEL=anthropic/claude-sonnet-4-5-20250929
# LLM_GROUP_GEN_MODEL=anthropic/claude-sonnet-4-5-20250929
# LLM_CHOICE_GEN_MODEL=anthropic/claude-haiku-4-5-20251001
# LLM_CONFUSABLE_GEN_MODEL=anthropic/claude-sonnet-4-5-20250929
# LLM_IDIOM_GEN_MODEL=anthropic/claude-sonnet-4-5-20250929

# --- Google Gemini ---
# LLM_PARTNER_MODEL=gemini/gemini-2.0-flash
# LLM_EDITOR_MODEL=gemini/gemini-2.0-flash
# LLM_USAGE_JUDGE_MODEL=gemini/gemini-2.0-flash
# LLM_DRILL_GEN_MODEL=gemini/gemini-2.0-flash
# LLM_DRILL_GRADE_MODEL=gemini/gemini-2.0-flash
# LLM_GROUP_GEN_MODEL=gemini/gemini-2.0-flash
# LLM_CHOICE_GEN_MODEL=gemini/gemini-2.0-flash
# LLM_CONFUSABLE_GEN_MODEL=gemini/gemini-2.0-flash
# LLM_IDIOM_GEN_MODEL=gemini/gemini-2.0-flash

# --- Ollama (local) ---
LLM_PARTNER_MODEL=ollama_chat/<local-model-tag>
LLM_EDITOR_MODEL=ollama_chat/<local-model-tag>
LLM_USAGE_JUDGE_MODEL=ollama_chat/<local-model-tag>
LLM_DRILL_GEN_MODEL=ollama_chat/<local-model-tag>
LLM_DRILL_GRADE_MODEL=ollama_chat/<local-model-tag>
LLM_GROUP_GEN_MODEL=ollama_chat/<local-model-tag>
LLM_CHOICE_GEN_MODEL=ollama_chat/<local-model-tag>
LLM_CONFUSABLE_GEN_MODEL=ollama_chat/<local-model-tag>
LLM_IDIOM_GEN_MODEL=ollama_chat/<local-model-tag>

# Mix providers freely, e.g. partner on Ollama + editor on Claude:
# LLM_PARTNER_MODEL=ollama_chat/llama3.2
# LLM_EDITOR_MODEL=anthropic/claude-sonnet-4-5-20250929

# Active prompt file version per role (prompts/<role>.v<N>.md).
LLM_PARTNER_PROMPT_VERSION=1
LLM_EDITOR_PROMPT_VERSION=4
LLM_USAGE_JUDGE_PROMPT_VERSION=1
LLM_DRILL_GEN_PROMPT_VERSION=2
LLM_DRILL_GRADE_PROMPT_VERSION=1
LLM_GROUP_GEN_PROMPT_VERSION=1
LLM_CONFUSABLE_GEN_PROMPT_VERSION=1
LLM_IDIOM_GEN_PROMPT_VERSION=1
LLM_CHOICE_GEN_PROMPT_VERSION=1

EDITOR_MAX_SUGGESTIONS=3
# Internal users.id allowed to open /admin/lexicon
ADMIN_USER_ID=

# Rolling 24h LLM ceilings (0 disables). Checked against llm_calls.
LLM_RATE_LIMIT_PER_DAY=200
LLM_COST_LIMIT_USD_PER_DAY=5.0

# Shown on /about/privacy. Override if your providers differ.
# LLM_PRIVACY_NOTE=

# Postgres example (after infra/postgres is up):
# DATABASE_URL=postgresql+psycopg://vocab:replace-me@localhost:5432/vocab
